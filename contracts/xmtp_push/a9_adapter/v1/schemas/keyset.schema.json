{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "keyset.schema.json",
  "title": "Hytch A9 Bridge Root-Signed Keyset v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "schema_version",
    "environment",
    "keyset_sequence",
    "issued_at",
    "expires_at",
    "keys",
    "commitment_keys",
    "root_signing_key_id",
    "root_signature_algorithm",
    "root_signature_base64url"
  ],
  "properties": {
    "protocol": {
      "const": "hytch.a9-bridge-keyset"
    },
    "schema_version": {
      "const": 1
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "keyset_sequence": {
      "$ref": "#/$defs/positive_safe_integer"
    },
    "issued_at": {
      "$ref": "#/$defs/rfc3339_millisecond_utc"
    },
    "expires_at": {
      "$ref": "#/$defs/rfc3339_millisecond_utc"
    },
    "keys": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/public_key"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "use",
              "state"
            ],
            "properties": {
              "use": {
                "const": "A9_CONTROL"
              },
              "state": {
                "const": "SIGN"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "use",
              "state"
            ],
            "properties": {
              "use": {
                "const": "SERVICE_AUTH"
              },
              "state": {
                "const": "SIGN"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "commitment_keys": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/commitment_key"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "purpose"
            ],
            "properties": {
              "purpose": {
                "const": "ROSTER"
              }
            }
          },
          "minContains": 1,
          "maxContains": 2
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "purpose"
            ],
            "properties": {
              "purpose": {
                "const": "TUPLE"
              }
            }
          },
          "minContains": 1,
          "maxContains": 2
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "purpose"
            ],
            "properties": {
              "purpose": {
                "const": "TOPIC"
              }
            }
          },
          "minContains": 1,
          "maxContains": 2
        }
      ]
    },
    "root_signing_key_id": {
      "$ref": "#/$defs/ed25519_key_id"
    },
    "root_signature_algorithm": {
      "const": "Ed25519"
    },
    "root_signature_base64url": {
      "$ref": "#/$defs/base64url_64"
    }
  },
  "$defs": {
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "production"
      ]
    },
    "positive_safe_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "positive_uint32": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "base64url_32": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "base64url_64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "ed25519_key_id": {
      "type": "string",
      "pattern": "^ed25519-sha256:[0-9a-f]{64}$"
    },
    "hmac_key_id": {
      "type": "string",
      "pattern": "^hmac-sha256:[0-9a-f]{64}$"
    },
    "rfc3339_millisecond_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "public_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "use",
        "public_key_base64url",
        "not_before",
        "not_after",
        "state"
      ],
      "properties": {
        "key_id": {
          "$ref": "#/$defs/ed25519_key_id"
        },
        "use": {
          "type": "string",
          "enum": [
            "A9_CONTROL",
            "SERVICE_AUTH"
          ]
        },
        "public_key_base64url": {
          "$ref": "#/$defs/base64url_32"
        },
        "not_before": {
          "$ref": "#/$defs/rfc3339_millisecond_utc"
        },
        "not_after": {
          "$ref": "#/$defs/rfc3339_millisecond_utc"
        },
        "state": {
          "type": "string",
          "enum": [
            "SIGN",
            "VERIFY_ONLY"
          ]
        }
      }
    },
    "commitment_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "key_id",
        "topic_key_epoch",
        "not_before",
        "not_after"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "enum": [
            "ROSTER",
            "TUPLE",
            "TOPIC"
          ]
        },
        "key_id": {
          "$ref": "#/$defs/hmac_key_id"
        },
        "topic_key_epoch": {
          "oneOf": [
            {
              "$ref": "#/$defs/positive_uint32"
            },
            {
              "type": "null"
            }
          ]
        },
        "not_before": {
          "$ref": "#/$defs/rfc3339_millisecond_utc"
        },
        "not_after": {
          "$ref": "#/$defs/rfc3339_millisecond_utc"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "TOPIC"
              }
            },
            "required": [
              "purpose"
            ]
          },
          "then": {
            "properties": {
              "topic_key_epoch": {
                "$ref": "#/$defs/positive_uint32"
              }
            }
          },
          "else": {
            "properties": {
              "topic_key_epoch": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
