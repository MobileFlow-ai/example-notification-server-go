{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result.schema.json",
  "title": "Hytch A9 Vault CAS Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "schema_version",
    "environment",
    "installation_binding_id",
    "sequencer_epoch",
    "subscription_generation",
    "state",
    "outcome",
    "accepted_stream_sequence",
    "idempotent_replay"
  ],
  "properties": {
    "protocol": {
      "const": "hytch.a9-vault-cas-result"
    },
    "schema_version": {
      "const": 1
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "installation_binding_id": {
      "$ref": "#/$defs/base64url_16"
    },
    "sequencer_epoch": {
      "$ref": "#/$defs/base64url_16"
    },
    "subscription_generation": {
      "$ref": "#/$defs/nonnegative_safe_integer"
    },
    "state": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "REVOKED",
        "UNCERTAIN"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "APPLIED",
        "REPLAY",
        "STALE",
        "GAP",
        "CONFLICT",
        "INCONCLUSIVE"
      ]
    },
    "accepted_stream_sequence": {
      "$ref": "#/$defs/nonnegative_safe_integer"
    },
    "idempotent_replay": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "REPLAY"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "idempotent_replay": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "idempotent_replay": {
            "const": false
          }
        }
      }
    }
  ],
  "$defs": {
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "production"
      ]
    },
    "base64url_16": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "nonnegative_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
