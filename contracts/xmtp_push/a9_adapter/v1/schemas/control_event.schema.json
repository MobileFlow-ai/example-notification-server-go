{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "control_event.schema.json",
  "title": "Hytch A9 Bridge Control Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "schema_version",
    "audience",
    "environment",
    "idempotency_key",
    "installation_binding_id",
    "sequencer_epoch",
    "stream_sequence",
    "expected_previous_sequence",
    "binding_id",
    "binding_version",
    "expected_binding_version",
    "action",
    "assertion",
    "assertion_hash",
    "reason_code",
    "issued_at",
    "expires_at",
    "signing_key_id",
    "signature_algorithm",
    "signature_base64url"
  ],
  "properties": {
    "protocol": {
      "const": "hytch.a9-bridge-control"
    },
    "schema_version": {
      "const": 1
    },
    "audience": {
      "const": "hytch.xmtp-push-bridge.a9-control"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "idempotency_key": {
      "$ref": "#/$defs/canonical_uuid"
    },
    "installation_binding_id": {
      "$ref": "#/$defs/base64url_16"
    },
    "sequencer_epoch": {
      "$ref": "#/$defs/base64url_16"
    },
    "stream_sequence": {
      "$ref": "#/$defs/positive_safe_integer"
    },
    "expected_previous_sequence": {
      "$ref": "#/$defs/nonnegative_safe_integer"
    },
    "binding_id": {
      "$ref": "#/$defs/base64url_16"
    },
    "binding_version": {
      "$ref": "#/$defs/positive_safe_integer"
    },
    "expected_binding_version": {
      "$ref": "#/$defs/nonnegative_safe_integer"
    },
    "action": {
      "type": "string",
      "enum": [
        "UPSERT",
        "REVOKE"
      ]
    },
    "assertion": {
      "oneOf": [
        {
          "$ref": "assertion.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "assertion_hash": {
      "$ref": "#/$defs/base64url_32"
    },
    "reason_code": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "enum": [
            "authority_revoked",
            "authority_expired",
            "authority_replaced"
          ]
        }
      ]
    },
    "issued_at": {
      "$ref": "#/$defs/rfc3339_millisecond_utc"
    },
    "expires_at": {
      "$ref": "#/$defs/rfc3339_millisecond_utc"
    },
    "signing_key_id": {
      "$ref": "#/$defs/ed25519_key_id"
    },
    "signature_algorithm": {
      "const": "Ed25519"
    },
    "signature_base64url": {
      "$ref": "#/$defs/base64url_64"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "UPSERT"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "assertion": {
            "$ref": "assertion.schema.json"
          },
          "reason_code": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "REVOKE"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "assertion": {
            "type": "null"
          },
          "reason_code": {
            "type": "string",
            "enum": [
              "authority_revoked",
              "authority_expired",
              "authority_replaced"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "production"
      ]
    },
    "canonical_uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "base64url_16": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "base64url_32": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "base64url_64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "ed25519_key_id": {
      "type": "string",
      "pattern": "^ed25519-sha256:[0-9a-f]{64}$"
    },
    "positive_safe_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nonnegative_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rfc3339_millisecond_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    }
  }
}
