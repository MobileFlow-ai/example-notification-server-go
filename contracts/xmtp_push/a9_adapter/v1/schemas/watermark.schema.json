{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "watermark.schema.json",
  "title": "Hytch A9 Control Watermark v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "schema_version",
    "audience",
    "environment",
    "installation_binding_id",
    "sequencer_epoch",
    "watermark_sequence",
    "committed_through_stream_sequence",
    "status",
    "uncertainty_reason",
    "issued_at",
    "expires_at",
    "signing_key_id",
    "signature_algorithm",
    "signature_base64url"
  ],
  "properties": {
    "protocol": {
      "const": "hytch.a9-control-watermark"
    },
    "schema_version": {
      "const": 1
    },
    "audience": {
      "const": "hytch.xmtp-push-bridge.a9-control"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "installation_binding_id": {
      "$ref": "#/$defs/base64url_16"
    },
    "sequencer_epoch": {
      "$ref": "#/$defs/base64url_16"
    },
    "watermark_sequence": {
      "$ref": "#/$defs/positive_safe_integer"
    },
    "committed_through_stream_sequence": {
      "$ref": "#/$defs/nonnegative_safe_integer"
    },
    "status": {
      "type": "string",
      "enum": [
        "CURRENT",
        "UNCERTAIN"
      ]
    },
    "uncertainty_reason": {
      "type": "string",
      "enum": [
        "NONE",
        "SOURCE_UNAVAILABLE",
        "OUTBOX_GAP",
        "REPLICA_AMBIGUITY",
        "OVERFLOW",
        "CLOCK_UNCERTAIN"
      ]
    },
    "issued_at": {
      "$ref": "#/$defs/rfc3339_millisecond_utc"
    },
    "expires_at": {
      "$ref": "#/$defs/rfc3339_millisecond_utc"
    },
    "signing_key_id": {
      "$ref": "#/$defs/ed25519_key_id"
    },
    "signature_algorithm": {
      "const": "Ed25519"
    },
    "signature_base64url": {
      "$ref": "#/$defs/base64url_64"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "CURRENT"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "uncertainty_reason": {
            "const": "NONE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "UNCERTAIN"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "uncertainty_reason": {
            "type": "string",
            "enum": [
              "SOURCE_UNAVAILABLE",
              "OUTBOX_GAP",
              "REPLICA_AMBIGUITY",
              "OVERFLOW",
              "CLOCK_UNCERTAIN"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "production"
      ]
    },
    "base64url_16": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "base64url_64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "ed25519_key_id": {
      "type": "string",
      "pattern": "^ed25519-sha256:[0-9a-f]{64}$"
    },
    "positive_safe_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nonnegative_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rfc3339_millisecond_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    }
  }
}
