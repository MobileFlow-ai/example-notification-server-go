{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assertion.schema.json",
  "title": "Hytch A9 Bridge Assertion v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "schema_version",
    "audience",
    "purpose",
    "environment",
    "binding_id",
    "installation_binding_id",
    "lease_id",
    "binding_version",
    "stream_sequence",
    "tuple_commitment",
    "tuple_commitment_key_id",
    "roster_commitment",
    "roster_commitment_key_id",
    "topic_binding",
    "topic_key_epoch",
    "conversation_generation",
    "roster_version",
    "state",
    "issued_at",
    "expires_at",
    "signing_key_id",
    "signature_algorithm",
    "signature_base64url"
  ],
  "properties": {
    "protocol": {
      "const": "hytch.a9-bridge-assertion"
    },
    "schema_version": {
      "const": 1
    },
    "audience": {
      "const": "hytch.xmtp-push-bridge.a9-control"
    },
    "purpose": {
      "const": "conversation_message_push"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "binding_id": {
      "$ref": "#/$defs/base64url_16"
    },
    "installation_binding_id": {
      "$ref": "#/$defs/base64url_16"
    },
    "lease_id": {
      "$ref": "#/$defs/base64url_16"
    },
    "binding_version": {
      "$ref": "#/$defs/positive_safe_integer"
    },
    "stream_sequence": {
      "$ref": "#/$defs/positive_safe_integer"
    },
    "tuple_commitment": {
      "$ref": "#/$defs/base64url_32"
    },
    "tuple_commitment_key_id": {
      "$ref": "#/$defs/hmac_key_id"
    },
    "roster_commitment": {
      "$ref": "#/$defs/base64url_32"
    },
    "roster_commitment_key_id": {
      "$ref": "#/$defs/hmac_key_id"
    },
    "topic_binding": {
      "$ref": "#/$defs/base64url_32"
    },
    "topic_key_epoch": {
      "$ref": "#/$defs/positive_uint32"
    },
    "conversation_generation": {
      "$ref": "#/$defs/positive_int32"
    },
    "roster_version": {
      "$ref": "#/$defs/positive_int32"
    },
    "state": {
      "const": "ACTIVE"
    },
    "issued_at": {
      "$ref": "#/$defs/rfc3339_millisecond_utc"
    },
    "expires_at": {
      "$ref": "#/$defs/rfc3339_millisecond_utc"
    },
    "signing_key_id": {
      "$ref": "#/$defs/ed25519_key_id"
    },
    "signature_algorithm": {
      "const": "Ed25519"
    },
    "signature_base64url": {
      "$ref": "#/$defs/base64url_64"
    }
  },
  "$defs": {
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "production"
      ]
    },
    "base64url_16": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "base64url_32": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "base64url_64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "ed25519_key_id": {
      "type": "string",
      "pattern": "^ed25519-sha256:[0-9a-f]{64}$"
    },
    "hmac_key_id": {
      "type": "string",
      "pattern": "^hmac-sha256:[0-9a-f]{64}$"
    },
    "positive_safe_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "positive_int32": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "positive_uint32": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "rfc3339_millisecond_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    }
  }
}
